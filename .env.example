# AMLL TTML API 环境变量示例文件
# 在本地开发或部署时，可复制此文件为 .env 或 /etc/amll-ttml-api/env 并填写具体配置

# 服务监听端口，默认 3000
PORT=3000

# 数据库连接 URL (默认 sqlite://data/amll_lyrics.db?mode=rwc)
DATABASE_URL=sqlite://data/amll_lyrics.db?mode=rwc

# Sentry 项目的 DSN 地址，若为空则不使用 Sentry 上报
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id

# Sentry 性能追踪采样率 (0.0 ~ 1.0)，默认 0 即只上报错误
# 逐请求数据由请求统计负责，排查性能问题时可临时调高
# SENTRY_TRACES_SAMPLE_RATE=0.01

# /v1/webhook/sync 接口的 Bearer Token 校验密钥
# 若为空将在调用接口时返回 500 错误
SYNC_SECRET=your_custom_secure_secret_here

# 请求统计的数据目录，未设置则关闭请求统计
# 目录下的 buffer.db 是逐请求记录的 SQLite 热缓冲，每天转成 parquet/YYYY-MM-DD.parquet，目录不存在时自动创建
# ANALYTICS_DIR=data/analytics

# 对客户端 IP 做 HMAC 的密钥，统计里只存摘要不存原始 IP，可用 `openssl rand -hex 32` 生成
# 未设置时其余字段照常记录，只是客户端标识留空；更换密钥等同于独立客户端重新开始计数
# ANALYTICS_IP_KEY=your_random_key_here

# 团队下载每日统计文件（/v1/admin/analytics/files）用的 Bearer Token，可用 `openssl rand -hex 32` 生成
# 未设置时下载端点返回 500
# ANALYTICS_SECRET=your_download_token_here
